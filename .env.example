# Copy to .env and replace the three password placeholders before starting.
MYSQL_DATABASE=gym_management
MYSQL_USER=gymapp
MYSQL_PASSWORD=replace-with-a-unique-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password
